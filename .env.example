# Native Adapter 运行参数示例
# 复制为本地环境文件后，替换所有 CHANGE_ME 值；不要提交真实凭据。
VOICE_ACCESS_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
HERMES_DASHBOARD_SESSION_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# 三个 Hermes Profile 的内部地址
HERMES_DEFAULT_URL=http://127.0.0.1:9120
HERMES_HEXIAOMA_URL=http://127.0.0.1:9121
HERMES_HEXIAOXIN_URL=http://127.0.0.1:9122

# 可选：Hermes 仅返回 provider=custom 时，为客户端补充具体服务名称
HERMES_DEFAULT_PROVIDER_LABEL=
HERMES_HEXIAOMA_PROVIDER_LABEL=
HERMES_HEXIAOXIN_PROVIDER_LABEL=

# 附件安全边界：多个目录用系统路径分隔符连接；默认仅允许 /tmp
VOICE_ARTIFACT_ROOTS=/tmp
VOICE_ARTIFACT_MAX_BYTES=52428800

# Native Adapter 监听地址
VOICE_HOST=127.0.0.1
VOICE_PORT=8844
